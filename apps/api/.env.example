PORT=3000
HOST=0.0.0.0
NODE_ENV=development
API_PREFIX=api/v1
CLINIC_TIMEZONE=America/Sao_Paulo

# Origens liberadas no CORS em produção (separadas por vírgula).
# Em desenvolvimento, qualquer origem é aceita.
CORS_ORIGIN=

# Banco de dados (PostgreSQL)
DATABASE_URL="postgresql://clinicflow:clinicflow@localhost:5432/clinicflow_db?schema=public"

# Autenticação: em produção, 32+ bytes aleatórios.
JWT_SECRET="dev-only-secret-nao-use-em-producao"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Janela do "Desfazer [Z]" do toast do painel do dia, em segundos.
UNDO_WINDOW_SECONDS=30

# Armazenamento de documentos: `local` grava em disco e assina a própria URL;
# `s3` emite presigned URL contra AWS/MinIO/R2.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_SIGNING_SECRET="dev-only-storage-secret"
STORAGE_UPLOAD_TTL=900
STORAGE_READ_TTL=3600
# Limite de upload em bytes (padrão: 10 MB).
STORAGE_MAX_FILE_BYTES=10485760

# Só quando STORAGE_DRIVER=s3 (MinIO local: http://localhost:9000)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=clinicflow
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true

# Automação WhatsApp: `log` só escreve no console e não envia nada.
NOTIFICATION_TRANSPORT=log
WHATSAPP_BASE_URL=
WHATSAPP_TOKEN=
WHATSAPP_WEBHOOK_SECRET="dev-only-webhook-secret"

# Token do chamador de painel de TV da sala de espera.
WAITING_ROOM_DISPLAY_TOKEN="dev-display-token"

# Rotinas periódicas (confirmações, expurgo, fechamento do dia).
JOBS_ENABLED=true

# Cliente HTTP de saída
HTTP_CLIENT_TIMEOUT_MS=8000
HTTP_CLIENT_RETRIES=2
