{
  "name": "@clinicflow/config",
  "version": "0.1.0",
  "private": true,
  "description": "Configurações compartilhadas (Biome, TypeScript, Jest) do ClinicFlow",
  "license": "MIT",
  "keywords": [
    "clinicflow",
    "config",
    "typescript",
    "jest",
    "biome"
  ],
  "scripts": {
    "build": "tsup"
  },
  "exports": {
    "./biome": "./dist/biome.json",
    "./typescript": "./dist/tsconfig.json",
    "./tsconfig.json": "./dist/tsconfig.json",
    "./jest": {
      "types": "./dist/jest.config.d.ts",
      "import": "./dist/jest.config.mjs",
      "require": "./dist/jest.config.js"
    }
  },
  "devDependencies": {
    "jest": "catalog:",
    "tsup": "^8.5.1"
  }
}
